#!/usr/bin/env bash
# tests/run — static checks for the site. Shared by both branches (main = 6b62.com,
# staging = new.6b62.com); checks that differ by site adapt to the content.
#
# Core checks need only coreutils + grep and run anywhere. The nginx -t and HTML-validation
# checks need docker; they auto-skip when docker (or the image) is unavailable, so a laptop
# without docker still runs the core checks, while CI runs everything.
set -uo pipefail
cd "$(dirname "$0")/.."

PASS=0 FAIL=0 SKIP=0
ok()   { printf '  ok    %s\n' "$1"; PASS=$((PASS+1)); }
bad()  { printf 'FAIL    %s\n' "$1"; FAIL=$((FAIL+1)); }
skip() { printf '  skip  %s (%s)\n' "$1" "$2"; SKIP=$((SKIP+1)); }
has()  { command -v "$1" >/dev/null 2>&1; }
ensure_img() { docker image inspect "$1" >/dev/null 2>&1 || docker pull -q "$1" >/dev/null 2>&1; }
contains() { if grep -qE "$2" "$1" 2>/dev/null; then ok "$3"; else bad "$3"; fi; }
lacks()    { if grep -qE "$2" "$1" 2>/dev/null; then bad "$3"; else ok "$3"; fi; }
exists()   { if [ -e "$1" ]; then ok "exists: $1"; else bad "exists: $1"; fi; }

# which environment is this tree? branch name from CI or git.
BR="${GITHUB_REF_NAME:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')}"

echo "# --- files present"
for f in site/index.html site/404.html site/.well-known/security.txt \
         nginx/default.conf nginx/nginx.conf deploy.sh README.md; do
  exists "$f"
done

echo "# --- no external requests"
lacks site/index.html 'fonts\.(googleapis|gstatic)\.com'   "no Google Fonts references"
lacks site/index.html '<link[^>]*stylesheet[^>]*https?://' "no external stylesheet"
lacks site/index.html '<script[^>]*src=[^>]*https?://'     "no external <script src>"
lacks site/index.html 'url\([[:space:]]*https?://'         "no external url() in CSS"
lacks site/index.html '(cdnjs|jsdelivr|unpkg|three\.min\.js)' "no CDN / Three.js leftovers"

echo "# --- fonts"
if grep -qE 'fonts/[A-Za-z0-9._-]+\.woff2' site/index.html; then
  miss=0
  for u in $(grep -oE 'fonts/[A-Za-z0-9._-]+\.woff2' site/index.html | sort -u); do
    [ -f "site/$u" ] || { echo "   missing: site/$u"; miss=1; }
  done
  [ "$miss" = 0 ] && ok "every referenced woff2 exists on disk" || bad "every referenced woff2 exists on disk"
  ls site/fonts/*.woff2 >/dev/null 2>&1 && ok "site/fonts/ has woff2 files" || bad "site/fonts/ has woff2 files"
  contains nginx/default.conf "font-src 'self'" "CSP: font-src 'self' (self-hosted fonts)"
else
  skip "self-hosted font checks" "page references no woff2 (system fonts)"
fi

echo "# --- head metadata"
contains site/index.html '<link rel="canonical"' "canonical present"
contains site/index.html '<title>[^<]+</title>'  "title present"

echo "# --- indexing (per environment)"
case "$BR" in
  staging) contains site/index.html '<meta name="robots" content="noindex' "staging is noindex";;
  main)    lacks    site/index.html '<meta name="robots" content="noindex' "production is indexable (no noindex)";;
  *)       skip "noindex check" "branch '$BR' is neither main nor staging";;
esac

echo "# --- security.txt"
contains site/.well-known/security.txt '^Contact:'   "security.txt has Contact"
contains site/.well-known/security.txt '^Canonical:' "security.txt has Canonical"

echo "# --- CSP (nginx)"
contains nginx/default.conf "default-src 'none'"               "CSP: default-src 'none'"
lacks    nginx/default.conf 'fonts\.(googleapis|gstatic)\.com' "CSP: no Google Fonts hosts"

echo "# --- nginx config valid (docker)"
if has docker && ensure_img nginx:alpine; then
  if docker run --rm \
      -v "$PWD/nginx/nginx.conf:/etc/nginx/nginx.conf:ro" \
      -v "$PWD/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro" \
      -v "$PWD/site:/usr/share/nginx/html:ro" \
      nginx:alpine nginx -t >/dev/null 2>&1; then
    ok "nginx -t"
  else
    bad "nginx -t"
  fi
else
  skip "nginx -t" "docker/image unavailable"
fi

echo "# --- HTML validation (docker: Nu validator)"
if has docker && ensure_img ghcr.io/validator/validator:latest; then
  out=$(docker run --rm -v "$PWD/site:/site:ro" ghcr.io/validator/validator:latest \
          vnu --skip-non-html /site 2>&1 | grep -v '^Picked up JAVA')
  if [ -z "$out" ]; then ok "vnu: HTML valid"; else bad "vnu: HTML invalid"; printf '%s\n' "$out"; fi
else
  skip "vnu HTML validation" "docker/image unavailable"
fi

echo
echo "branch=${BR:-?}  pass=$PASS fail=$FAIL skip=$SKIP"
[ "$FAIL" = 0 ]
