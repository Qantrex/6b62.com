#!/usr/bin/env bash
# tests/run — static checks for the site. Shared by both branches (main = 6b62.com,
# staging = new.6b62.com); site/index.html is the same on both, only the nginx config differs.
#
# Core checks need only coreutils, grep and python3 and run anywhere. The nginx -t and HTML-validation
# checks need docker; they auto-skip when docker (or the image) is unavailable, so a laptop
# without docker still runs the core checks, while CI runs everything.
set -uo pipefail
cd "$(dirname "$0")/.."

PASS=0 FAIL=0 SKIP=0
ok()   { printf '  ok    %s\n' "$1"; PASS=$((PASS+1)); }
bad()  { printf 'FAIL    %s\n' "$1"; FAIL=$((FAIL+1)); }
skip() { printf '  skip  %s (%s)\n' "$1" "$2"; SKIP=$((SKIP+1)); }
has()  { command -v "$1" >/dev/null 2>&1; }
ensure_img() { docker image inspect "$1" >/dev/null 2>&1 || docker pull -q "$1" >/dev/null 2>&1; }
contains() { if grep -qE "$2" "$1" 2>/dev/null; then ok "$3"; else bad "$3"; fi; }
lacks()    { if grep -qE "$2" "$1" 2>/dev/null; then bad "$3"; else ok "$3"; fi; }
exists()   { if [ -e "$1" ]; then ok "exists: $1"; else bad "exists: $1"; fi; }
P=site/index.html

echo "# --- files present"
for f in $P site/404.html site/.well-known/security.txt build.py src/head.html src/pad.html \
         nginx/nginx.conf nginx/main.conf nginx/staging.conf deploy.sh README.md; do
  exists "$f"
done

echo "# --- the budget: exactly 27,490 bytes, built from src/"
n=$(wc -c < "$P")
[ "$n" = 27490 ] && ok "site/index.html is 27490 bytes" || bad "site/index.html is 27490 bytes (got $n)"
python3 build.py --check >/dev/null && ok "build.py --check: the page is what src/ builds" || bad "build.py --check: run ./build.py"

echo "# --- linker map: every printed range is that block's real bytes"
if python3 - "$P" <<'EOF'
import re, sys
b = open(sys.argv[1], 'rb').read()
blocks = re.findall(rb'<(?:section|header) id="(\w+)"[^>]*>\n<p class="map"[^>]*><span>(0x[0-9a-f]{4}) \xe2\x80\x93 (0x[0-9a-f]{4})</span><span>\s*([\d,]+) B</span>', b)
want = [b'top', b'about', b'edu', b'job', b'work', b'cert', b'skills', b'notes', b'contact', b'pad']
assert [x[0] for x in blocks] == want, "blocks missing or out of order"
pos = 0
for name, s, e, n in blocks:
    s, e, n = int(s, 16), int(e, 16), int(n.replace(b',', b''))
    assert s == pos and e - s == n, f"{name}: range does not line up"
    chunk = b[s:e]
    tag = b'<!doctype' if name == b'top' else b'<section id="' + name + b'"'
    assert chunk.startswith(tag), f"{name}: range does not start at the block"
    pos = e
assert pos == len(b) == 27490, "ranges do not cover the whole file"
hexstr = re.search(rb'<p class="hex"[^>]*>([0-9a-f]+)', b).group(1).decode()
msg = bytes.fromhex(hexstr).rstrip(b'\0')
assert msg and all(32 <= c < 127 or c == 10 for c in msg), "pad does not decode to ASCII"
EOF
then ok "ranges are contiguous, start at their blocks, cover all 27490 bytes; .pad decodes to ASCII"
else bad "linker map ranges"; fi

contains $P '<code>curl -s https://6b62\.com \| wc -c +<span># 27490</span></code>' "the size check is on the page, as text"

echo "# --- one request: no scripts, fonts, images or external requests"
lacks $P '<script'                          "no <script> (no JavaScript, no JSON-LD)"
lacks $P '<link[^>]*stylesheet'             "no external stylesheet"
lacks $P '@font-face|\.woff2?'              "no web fonts (system fonts only)"
lacks $P '<img|<iframe|<object|<embed'      "no images or embeds"
lacks $P 'url\([[:space:]]*["'"'"']?https?:' "no external url() in CSS"
lacks $P 'src="https?:'                     "no external src="
contains $P 'rel="icon" href="data:'        "favicon is an inline data URI"

echo "# --- email: entity-encoded, never plaintext (Cloudflare's obfuscation is off)"
lacks $P '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}' "no plaintext email address"
lacks $P 'mailto:'                          "no plaintext mailto:"
lacks $P 'cfemail|email-protection'         "no Cloudflare email markup"
if python3 - "$P" <<'PY'
import html, re, sys
b = open(sys.argv[1], encoding="utf-8").read()
links = [html.unescape(h) for h in re.findall(r'<a class="v" href="([^"]+)">([^<]+)</a>', b) for h in [h[0]]]
texts = [html.unescape(t) for _, t in re.findall(r'<a class="v" href="([^"]+)">([^<]+)</a>', b)]
assert "mailto:konstantin@wbauer.com" in links, links
assert "konstantin@wbauer.com" in texts, texts
PY
then ok "the encoded link decodes to mailto:konstantin@wbauer.com"; else bad "the encoded link decodes to mailto:konstantin@wbauer.com"; fi

echo "# --- screen readers"
n_bar=$(grep -oE '<a href="#[a-z]+"[^>]* style="width:' $P | wc -l)
n_lab=$(grep -oE '<a href="#[a-z]+" aria-label="[^"]+" style="width:' $P | wc -l)
[ "$n_bar" -gt 0 ] && [ "$n_bar" = "$n_lab" ] && ok "every bar link has an aria-label ($n_lab)" || bad "every bar link has an aria-label ($n_lab of $n_bar)"
n_map=$(grep -c '<p class="map"' $P); n_maph=$(grep -c '<p class="map" aria-hidden="true">' $P)
[ "$n_map" = "$n_maph" ] && ok "every .map is aria-hidden ($n_maph)" || bad "every .map is aria-hidden ($n_maph of $n_map)"
contains $P '<p class="hex" aria-hidden="true" tabindex="-1">' ".pad hex is aria-hidden and out of the tab order"

echo "# --- head metadata (identical on both hosts)"
contains $P '<link rel="canonical" href="https://6b62.com/">' "canonical is https://6b62.com/"
contains $P '<meta property="og:url" content="https://6b62.com/">' "og:url is https://6b62.com/"
lacks    $P '<meta name="robots"'           "no robots meta (staging is noindexed by its nginx header)"
contains $P '<html lang="en">'              "lang set"
contains $P 'class="skip"'                  "skip link present"
lacks    $P 'new\.6b62\.com'                "never links to new.6b62.com"

echo "# --- security.txt"
contains site/.well-known/security.txt '^Contact:'   "security.txt has Contact"
contains site/.well-known/security.txt '^Canonical: https://6b62\.com/' "security.txt Canonical is 6b62.com"

echo "# --- nginx configs"
for c in nginx/main.conf nginx/staging.conf; do
  contains $c "default-src 'none'"        "$c: CSP default-src 'none'"
  lacks    $c "script-src"                "$c: CSP allows no scripts"
  lacks    $c "^[[:space:]]*sub_filter"   "$c: never rewrites the body"
  contains $c 'add_header X-Flag '        "$c: flag header"
done
contains nginx/staging.conf 'X-Robots-Tag "noindex, nofollow"' "staging.conf: X-Robots-Tag noindex, nofollow"
lacks    nginx/main.conf    'X-Robots-Tag'                     "main.conf: production stays indexable"
contains nginx/main.conf    'security\.txt'                    "main.conf: serves security.txt"

echo "# --- nginx config valid (docker)"
if has docker && ensure_img nginx:alpine; then
  for c in main staging; do
    if docker run --rm \
        -v "$PWD/nginx/nginx.conf:/etc/nginx/nginx.conf:ro" \
        -v "$PWD/nginx/$c.conf:/etc/nginx/conf.d/default.conf:ro" \
        -v "$PWD/site:/usr/share/nginx/html:ro" \
        nginx:alpine nginx -t >/dev/null 2>&1; then
      ok "nginx -t ($c.conf)"
    else
      bad "nginx -t ($c.conf)"
    fi
  done
else
  skip "nginx -t" "docker/image unavailable"
fi

echo "# --- HTML validation (docker: Nu validator)"
if has docker && ensure_img ghcr.io/validator/validator:latest; then
  out=$(docker run --rm -v "$PWD/site:/site:ro" ghcr.io/validator/validator:latest \
          vnu --skip-non-html /site 2>&1 | grep -v '^Picked up JAVA')
  if [ -z "$out" ]; then ok "vnu: HTML valid"; else bad "vnu: HTML invalid"; printf '%s\n' "$out"; fi
else
  skip "vnu HTML validation" "docker/image unavailable"
fi

echo
echo "branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')  pass=$PASS fail=$FAIL skip=$SKIP"
[ "$FAIL" = 0 ]
